{
  "recipe": "setup/chat_facts_v10_config.json",
  "checkpoint_dir": "output/checkpoints/chat_facts_v10",
  "run_name": "chat_facts_v10",
  "max_steps": 10000,
  "eval_every": 50,
  "log_every": 1,
  "max_wall_s": 28800,
  "early_stop_patience": 200,
  "loss_spike_ratio": 2.0,
  "loss_median_window": 5,
  "promote_on": {
    "metric": "val_loss",
    "mode": "min"
  },
  "remix_if": {
    "cabinet_exact_match_below": -1.0,
    "after_steps": 999999,
    "action": "abort_remix"
  },
  "probe_on_stop": true,
  "probe_mode": "inject",
  "probe_n": 50,
  "probe_ood": true,
  "probe_seed": 42,
  "hard_limits": {
    "refuse_resume_on_vocab_mismatch": true,
    "refuse_existing_v6_v4_dir": true,
    "always_abort_on_nan": true,
    "always_abort_on_spike": true
  },
  "unguarded_defaults": {
    "skip_quarantine_on_next_mix": true,
    "allow_overwrite_latest": true
  }
}
